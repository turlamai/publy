{
  "name": "@turlamai/publy",
  "version": "1.1.0",
  "description": "Internal Publy CLI development build; not published to npm",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "publy": "dist/index.js"
  },
  "files": [
    "dist",
    "themes",
    "fonts",
    "samples",
    "third-party-notices.txt"
  ],
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "test": "node scripts/verify-preflight.mjs && node scripts/verify-theme-bundles.mjs"
  },
  "keywords": [
    "wechat",
    "official-account",
    "image-post",
    "markdown",
    "publishing",
    "cli"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turlamai/publy.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.10.0",
    "juice": "^11.0.0",
    "markdown-it": "^14.1.0",
    "satori": "^0.33.5",
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@publy/core": "workspace:*",
    "@publy/shared": "workspace:*"
  },
  "private": true
}
